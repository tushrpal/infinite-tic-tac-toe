# Backend runtime
NODE_ENV=development
PORT=3000

# Public WebSocket URL exposed to clients (for logs/health/docs)
WS_URL=wss://localhost:3000

# Local Docker PostgreSQL connection used by Prisma runtime and migrations
# Uses host port 5433 to avoid conflicts with a local Postgres on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/infinite_ttt?schema=public

# Local Docker Redis connection for matchmaking and active match state
REDIS_URL=redis://localhost:6379

# Cloud examples (uncomment and replace when deploying)
# DATABASE_URL=postgresql://user:password@db.example.com:5432/infinite_ttt?sslmode=require
# REDIS_URL=rediss://default:password@redis.example.com:6379

# Supabase (use the Session pooler string, port 5432, from Connect -> Direct connection string)
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: PEM contents of the DB's CA certificate to fully verify TLS (Supabase: Database
# Settings -> SSL Configuration -> Download certificate). Without it, sslmode=require encrypts
# the connection but does not verify the server certificate.
# DATABASE_SSL_CA=

# Optional: used by prisma migrate dev in local environments
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/infinite_ttt_shadow?schema=public

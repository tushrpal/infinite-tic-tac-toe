generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Player {
    id            String        @id
    username      String        @unique
    displayName   String?

    // OAuth authentication
    oauthProvider String?
    oauthId       String?
    oauthEmail    String?

    // Account metadata
    isAnonymous   Boolean       @default(true)
    lastLoginAt   DateTime?

    ratingMode1   Int           @default(1200)
    ratingMode2   Int           @default(1200)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    matches       MatchPlayer[]
    sessions      Session[]

    @@unique([oauthProvider, oauthId])
    @@index([ratingMode1])
    @@index([ratingMode2])
    @@index([username])
    @@index([oauthProvider, oauthId])
}

model Session {
    id        String   @id @default(cuid())
    playerId  String
    token     String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

    @@index([playerId])
    @@index([token])
    @@index([expiresAt])
}

model Match {
    id           String        @id
    mode         String
    isRanked     Boolean
    difficulty   String
    winner       String?
    roundsPlayed Int
    totalMoves   Int
    drawCount    Int
    createdAtMs  BigInt
    payload      Json
    persistedAt  DateTime      @default(now())
    players      MatchPlayer[]
    moves        Move[]
}

model MatchPlayer {
    id           String   @id @default(cuid())
    matchId      String
    playerId     String
    playerType   String
    ratingChange Int?
    createdAt    DateTime @default(now())
    match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
    player       Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

    @@unique([matchId, playerId])
    @@index([playerId])
}

model Move {
    id             String   @id @default(cuid())
    matchId        String
    gameIndex      Int
    index          Int
    playerId       String
    playerSymbol   String
    turn           Int
    timestampMs    BigInt?
    gameWinner     String?
    gameTotalMoves Int
    gameBoardSize  Int
    createdAt      DateTime @default(now())
    match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

    @@index([matchId, gameIndex, turn])
}

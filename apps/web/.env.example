# Public backend HTTP base URL consumed by browser code
# Local development: Use localhost or your local IP
NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://192.168.0.4:3000  # For testing on local network

# Public backend WebSocket URL consumed by browser code
# Local development: Use localhost or your local IP
NEXT_PUBLIC_WS_URL=ws://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://192.168.0.4:3000  # For testing on local network

# Production: Set these in Vercel environment variables
# NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
# NEXT_PUBLIC_WS_URL=wss://your-backend.vercel.app

# Canonical public site URL for SEO metadata, sitemap, and Open Graph
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public backend HTTP base URL consumed by browser code
# Local development: Use localhost or your local IP
NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://192.168.0.4:3000  # For testing on local network

# Public backend WebSocket URL consumed by browser code
# Local development: Use localhost or your local IP
NEXT_PUBLIC_WS_URL=ws://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://192.168.0.4:3000  # For testing on local network

# Production: Set these in Vercel environment variables
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
# NEXT_PUBLIC_WS_URL=wss://your-backend.vercel.app

# Home page hero: set to true to skip the interactive 3D board and always show
# the lightweight static one. Restart `next dev` / rebuild after changing it.
# NEXT_PUBLIC_DISABLE_3D_BOARD=true

# IndexNow (Bing/Yandex instant indexing). The key, the INDEXNOW_KEY value and
# the filename of public/{key}.txt must all be identical or verification fails.
# A key file is already committed for the value below; generate a replacement
# with `openssl rand -hex 16` and rename the file if you rotate it.
# Production only — no NEXT_PUBLIC_ prefix, this must stay server-side.
# INDEXNOW_KEY=43fc6199544fd895369b5963e86a8dbe

# Search engine ownership verification. Both are rendered into the HTML as meta
# tags, so they are public by design. DNS verification is the primary method;
# these are a second signal so a DNS change cannot silently un-verify us.
# Get the Google value from Search Console's "HTML tag" method (the content
# attribute only), and the Bing value from Bing Webmaster Tools' meta tag.
# Set both in Vercel Production. See docs/SEO_SETUP_RUNBOOK.md.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
